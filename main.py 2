# ==========================================
# Section 3. 일별 10위권 관객 합계 영역 그래프
# ==========================================
st.header("3. 날짜별 TOP 10 총 관객수 합계 추이")

# 날짜별 10위권 일관객 합계 집계
daily_total = df.groupby('날짜')['일관객'].sum().reset_index()

# 일관객 합계 상위 3일 추출
top3_days = daily_total.nlargest(3, '일관객').sort_values('일관객', ascending=False)

# Plotly 영역 그래프 생성
fig3 = px.area(
    daily_total,
    x='날짜',
    y='일관객',
    title="날짜별 TOP 10 영화 총 관객수 합계 (상위 3일 표시)",
    labels={'날짜': '날짜', '일관객': '총 관객수(명)'}
)

fig3.update_traces(
    hovertemplate="<b>날짜:</b> %{x|%Y-%m-%d}<br><b>총 관객수:</b> %{y:,}명<extra></extra>",
    line_color='#1f77b4',
    fillcolor='rgba(31, 119, 180, 0.3)'
)

# 상위 3일 위치에 주석(어노테이션) 및 마커 추가
for rank, row in enumerate(top3_days.itertuples(), start=1):
    date_str = row.날짜.strftime('%Y-%m-%d')
    total_val = row.일관객
    
    fig3.add_annotation(
        x=row.날짜,
        y=total_val,
        text=f"<b>{rank}위: {date_str}</b><br>({total_val:,}명)",
        showarrow=True,
        arrowhead=2,
        arrowsize=1,
        arrowwidth=2,
        arrowcolor="#d62728",
        ax=0,
        ay=-40,
        bgcolor="#ffffff",
        bordercolor="#d62728",
        borderwidth=1.5,
        borderpad=4
    )

fig3.update_layout(
    xaxis_title="날짜",
    yaxis_title="10위권 관객 합계(명)",
    hovermode="x unified"
)

st.plotly_chart(fig3, use_container_width=True)

# 작성할 문구 영역
st.info("💡 **이 그래프로 알 수 있는 것:** (여기에 작성할 문구를 입력하세요)")

