# ==========================================
# Section 5. 월×요일별 일관객 합계 히트맵
# ==========================================
st.header("5. 월×요일별 총 관객수 합계 히트맵")

# 월, 요일 데이터 파생 변수 생성
df_hm = df.copy()
df_hm['월'] = df_hm['날짜'].dt.month.astype(str) + '월'
df_hm['요일'] = df_hm['날짜'].dt.day_name()

# 요일 한글 변환 및 순서 정의 (월요일 -> 일요일)
day_map = {
    'Monday': '월요일',
    'Tuesday': '화요일',
    'Wednesday': '수요일',
    'Thursday': '목요일',
    'Friday': '금요일',
    'Saturday': '토요일',
    'Sunday': '일요일'
}
df_hm['요일'] = df_hm['요일'].map(day_map)

# 월/요일 순서 정의
months_order = [f"{i}월" for i in range(1, 13)]
days_order = ['월요일', '화요일', '수요일', '목요일', '금요일', '토요일', '일요일']

# 월 x 요일 그룹화 및 관객수 합계 집계
heatmap_df = df_hm.groupby(['월', '요일'])['일관객'].sum().reset_index()

# 피벗 테이블 생성 (행: 월, 열: 요일)
pivot_df = heatmap_df.pivot(index='월', columns='요일', values='일관객')

# 순서 재정렬 (데이터에 존재하는 월/요일 기준)
existing_months = [m for m in months_order if m in pivot_df.index]
existing_days = [d for d in days_order if d in pivot_df.columns]
pivot_df = pivot_df.reindex(index=existing_months, columns=existing_days).fillna(0)

# 히트맵 그래프 생성
fig5 = px.imshow(
    pivot_df,
    labels=dict(x="요일", y="월", color="총 관객수(명)"),
    x=existing_days,
    y=existing_months,
    color_continuous_scale="Blues", # 색이 진할수록 관객 수가 많아짐
    title="월×요일별 관객수 합계 분포"
)

# 마우스 오버(툴팁) 커스텀 설정
fig5.update_traces(
    hovertemplate="<b>%{y} %{x}</b><br>총 관객수: %{z:,}명<extra></extra>"
)

fig5.update_layout(
    xaxis_title="요일",
    yaxis_title="월",
    coloraxis_colorbar=dict(title="관객수(명)")
)

st.plotly_chart(fig5, use_container_width=True)

# 작성할 문구 영역
